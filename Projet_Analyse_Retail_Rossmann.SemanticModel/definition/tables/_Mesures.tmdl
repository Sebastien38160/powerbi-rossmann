	measure 'Icone Clients Promo' =
			
			imgBadgeEmbeddedAllIcons("users", "#FFFFFF", "#0078D4", 60, 12, 2)
		displayFolder: Icone
		lineageTag: 40a20145-e4e8-4985-b3e3-6481d247bd29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Taux de jours en Promo %' = ```
			
			// On calcule d'abord le nombre de jours avec promo 
			DIVIDE (
			    CALCULATE ( [Jours Ouverts], 'Fait_Historique des ventes'[Promotion active] = 1 ),
			    CALCULATE ( [Jours Ouverts], Dim_Calendrier[Jour Semaine No] <= 5 )
			)
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 03 - Promotions
		lineageTag: a688dcb2-a223-4351-9f85-7a34b41ab97c

	measure 'Moyenne CA Réseau' = ```
			
			// Calcule la moyenne globale de CA peu importe le type de magasin
			CALCULATE(
			    [CA Moyen par Jour], 
			    ALLSELECTED('Dim_Magasin'[Type de magasin])
			)
			```
		displayFolder: 03 - Promotions
		lineageTag: 9a1baca1-f8ff-45d2-b26f-e73eb0d7a6cb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Titre Dynamique Corrélation' =
			
			VAR Annee = SELECTEDVALUE ( 'Dim_Calendrier'[Annee], "Toutes années" )
			VAR TypeMag = SELECTEDVALUE ( 'Dim_Magasin'[Type de magasin], "Tous types" )
			RETURN
			    "Deux modèles dans un même réseau : fréquentation contre panier moyen | "
			        & Annee & " · " & TypeMag
		displayFolder: Icone
		lineageTag: c35cd42b-428c-467e-87a4-5a9ee82f8879

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Titre Dynamique Graphiques' = ```
			
			VAR Annee = SELECTEDVALUE('Dim_Calendrier'[Annee], "Toutes les années")
			VAR Trimestre = SELECTEDVALUE('Dim_Calendrier'[Trimestre], "Tous les trimestres")
			VAR TypeMag = SELECTEDVALUE('Dim_Magasin'[Type de magasin], "Tous types")
			
			RETURN
			"Quel format profite le plus des promotions ? " & 
			IF(ISFILTERED('Dim_Calendrier'[Mois Abrege]), "Mois", " | " & "Période") & 
			" | " & Annee & " " & 
			" | Magasins : " & TypeMag
			```
		displayFolder: Icone
		lineageTag: c8a0c847-c447-4087-be84-0f461bcd88db

