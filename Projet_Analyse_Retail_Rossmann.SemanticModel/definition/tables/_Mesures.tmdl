	measure 'CA Evolution Infobulle' =
			
			VAR TypeSelectionne = SELECTEDVALUE('Dim_Magasin'[Type de magasin])
			RETURN
			CALCULATE(
			    [CA Moyen par Jour],
			    ALL('Dim_Calendrier'), -- On ignore le mois survolé
			    ALLSELECTED(),         -- On ignore les filtres de mesures du nuage de points
			    'Dim_Magasin'[Type de magasin] = TypeSelectionne -- On réinjecte le magasin
			)
		displayFolder: Icone
		lineageTag: 5a0e2e21-62d9-40e6-9969-856dafb32eb5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Panier Moyen' =
			-- =============================================
			-- MESURE : Panier Moyen
			-- Dossier : 01 - KPI de base
			-- =============================================
			-- Description :
			--   Alias explicit de CA par Client.
			--   CA total divisé par le nombre total de clients.
			--   Indique combien chaque client dépense en moyenne par visite.
			--   Utilisé dans les visuels où le libellé "Panier Moyen" est
			--   plus explicite pour un public non technique.
			-- =============================================
			DIVIDE([CA Total], [Passage en Caisse])
		formatString: #,0.00 €
		displayFolder: 01 - KPI de base
		lineageTag: 9aa030b0-c369-4d7e-9d57-3ca80238d661

	measure 'Variation CA' =
			
			[CA Total]-[CA Année Précédente]
		displayFolder: 01 - KPI de base
		lineageTag: be0e9a78-3a57-4922-8d47-1cb81c1c5350

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Icone Calendrier' = ```
			
			IF(
			    ISINSCOPE('Dim_Calendrier'[Annee Mois]), 
			    imgBadgeEmbeddedAllIcons("calendar", "#E2001A", "", 24, 0, 2),
			    BLANK()
			)
			```
		displayFolder: Icone
		lineageTag: f01d62d7-b77b-4a54-9f18-9164e5b210f3
		dataCategory: ImageUrl

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Icone Menu Temporelle' =
			
			imgBadgeEmbeddedAllIcons("calendar-days", "#FFFFFF", "", 50, 0, 2)
		displayFolder: Icone
		lineageTag: 0e07ae4d-cbb3-4e84-a561-2a4a06d871d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CA par Jour Ouvert' =
			-- =============================================
			-- MESURE : CA par Jour Ouvert
			-- =============================================
			-- Description :
			--   CA réalisé divisé par le nombre de jours d'ouverture.
			--   Mesure la performance réelle indépendamment du nombre
			--   de jours ouverts. Permet de comparer des années avec
			--   des périodes ou des volumetries de jours différentes.
			--   En 2014 : +3,1% vs 2013 malgré un CA total en baisse.
			-- =============================================
			DIVIDE(
			    CALCULATE([CA Total], 'Fait_Historique des ventes'[Magasin ouvert] = 1),
			    CALCULATE(COUNTROWS('Fait_Historique des ventes'), 'Fait_Historique des ventes'[Magasin ouvert] = 1)
			)
		formatString: #,0 €
		displayFolder: 08 - Perimetre constant
		lineageTag: 40220ece-b09e-4044-80be-c4865984563f

	measure 'CA par Jour Ouvert N-1' =
			-- =============================================
			-- MESURE : CA par Jour Ouvert N-1
			-- =============================================
			-- Description :
			--   CA par jour ouvert de la même période l'année précédente.
			--   Sert de base de comparaison pour la croissance
			--   à périmètre constant.
			-- =============================================
			CALCULATE(
			    [CA par Jour Ouvert],
			    SAMEPERIODLASTYEAR('Dim_Calendrier'[Date])
			)
		formatString: #,0 €
		displayFolder: 08 - Perimetre constant
		lineageTag: 6f2a3db2-79c4-46ea-98f3-69ebbcf9687a

	measure 'Croissance CA Constant %' =
			-- =============================================
			-- MESURE : Croissance CA Perimetre Constant %
			-- =============================================
			-- Description :
			--   Évolution du CA PAR JOUR OUVERT vs année précédente.
			--   Neutralise l'effet du nombre de jours ouverts.
			--   Si positif alors que le CA total est négatif : la baisse
			--   globale vient d'une réduction des jours ouverts,
			--   pas d'une perte de performance commerciale.
			--   Ex. 2014 : CA total -5,3% MAIS performance +3,1%
			--   => les magasins vendent mieux, il y a juste moins de jours.
			-- =============================================
			DIVIDE(
			    [CA par Jour Ouvert] - [CA par Jour Ouvert N-1],
			    [CA par Jour Ouvert N-1]
			)
		displayFolder: 08 - Perimetre constant
		lineageTag: ce493368-5252-4d8c-b3ca-93bf59908fec

		formatStringDefinition = "▲+0.0%;▼-0.0%;0.0%"

	measure 'Nombre de magasin' = DISTINCTCOUNT(Dim_Magasin[ID Magasin])
		displayFolder: 04 - Magasins
		lineageTag: 022a7d3d-963c-4c48-bcf8-9f8b1e842b86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variation CA vs N-1' =
			
			VAR CA_N = [CA Total]
			VAR CA_N1 = [CA Année Précédente]
			RETURN
			    IF (
			        NOT ISBLANK ( CA_N ) && NOT ISBLANK ( CA_N1 ),
			        CA_N - CA_N1
			    )
		displayFolder: 02 - Performance temporelle
		lineageTag: ef3675b6-56a6-4e58-978c-02aa4f7c6581

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Nombre de samedis effectivement couverts par les donnees de ventes. Compte les dates de la table de faits, pas celles du calendrier : Dim_Calendrier va jusqu'au 31/12/2015 alors que les ventes s'arretent au 31/07/2015.
	measure 'Nombre de Samedis' =
			-- =============================================
			-- MESURE : Nombre de Samedis
			-- Dossier : 05 - Analyse temporelle
			-- =============================================
			-- Description :
			--   Compte les samedis presents dans la table de faits.
			-- Pourquoi la table de faits et non le calendrier :
			--   Dim_Calendrier couvre 1095 dates (2013-2015 complet) alors que
			--   les ventes s'arretent au 31/07/2015, soit 942 dates. Compter les
			--   156 samedis du calendrier au lieu des 134 renseignes diluerait
			--   toute moyenne par samedi de 16 pour cent.
			-- =============================================
			CALCULATE (
			    DISTINCTCOUNT ( 'Fait_Historique des ventes'[Date] ),
			    'Dim_Calendrier'[Jour Semaine No] = 6
			)
		formatString: #,0
		displayFolder: 05 - Analyse temporelle
		lineageTag: 68b6d0b7-f15a-466a-8295-91e7ec1980ba

	/// Chiffre d'affaires realise les samedis.
	measure 'CA Samedi' =
			-- =============================================
			-- MESURE : CA Samedi
			-- Dossier : 05 - Analyse temporelle
			-- =============================================
			-- Description :
			--   CA Total restreint aux samedis.
			-- =============================================
			CALCULATE ( [CA Total], 'Dim_Calendrier'[Jour Semaine No] = 6 )
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		displayFolder: 05 - Analyse temporelle
		lineageTag: 5e186ed7-cedf-41e1-83c0-d20336e51e0a

	/// CA reseau moyen genere un samedi. Denominateur = nombre de samedis calendaires, tous magasins confondus.
	measure 'CA Moyen par Samedi' =
			-- =============================================
			-- MESURE : CA Moyen par Samedi
			-- Dossier : 05 - Analyse temporelle
			-- =============================================
			-- Description :
			--   CA reseau moyen d'un samedi = CA Samedi / Nombre de Samedis.
			-- Attention :
			--   Base jour calendaire reseau, differente de [CA Moyen par Jour]
			--   qui est une moyenne par couple magasin-jour ouvert.
			-- =============================================
			DIVIDE ( [CA Samedi], [Nombre de Samedis] )
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		displayFolder: 05 - Analyse temporelle
		lineageTag: e406c73a-73a2-479c-b156-93776dc340d1

	/// Performance d'un samedi rapportee a celle d'un jour moyen, base 100. Calcule sur le CA par magasin-jour ouvert, ce qui neutralise le nombre de magasins ouverts. 100 = samedi dans la moyenne, 120 = samedi 20 % au-dessus.
	measure 'Indice Samedi' = ```
			-- =============================================
			-- MESURE : Indice Samedi
			-- Dossier : 05 - Analyse temporelle
			-- =============================================
			-- Description :
			--   Rapport entre le CA par magasin-jour ouvert du samedi et celui
			--   d'un jour moyen de la periode, en base 100.
			-- Pourquoi le CA par magasin-jour et non par jour calendaire :
			--   le nombre de magasins ouverts varie fortement selon le jour
			--   de la semaine (dimanche quasi ferme). Rapporter au magasin-jour
			--   isole la performance et neutralise cet effet de composition.
			-- Lecture :
			--   100 = samedi conforme a la moyenne
			--   > 100 = samedi surperformant
			-- ============================================= 
			DIVIDE ( [CA Moyen par Samedi], [CA Moyen par Jour Ouvré] )
			```
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: 05 - Analyse temporelle
		lineageTag: 990bb60b-e37d-4db4-9fe0-f25f2b358914

	/// CA reseau moyen d'un jour ouvre (lundi a vendredi). Denominateur corrige : compte les dates presentes dans les ventes, et non les dates du calendrier, qui court jusqu'au 31/12/2015 sans donnees apres le 31/07/2015.
	measure 'CA Moyen par Jour Ouvré' =
			-- =============================================
			-- MESURE : CA Moyen par Jour Ouvre
			-- Dossier : 05 - Analyse temporelle
			-- =============================================
			-- Correction :
			--   Le denominateur comptait les dates de Dim_Calendrier, qui
			--   contient 109 jours ouvres sans aucune vente (aout a decembre
			--   2015). La moyenne etait sous-estimee de 16 pour cent.
			-- =============================================
			DIVIDE (
			    CALCULATE ( [CA Total], 'Dim_Calendrier'[Jour Semaine No] <= 5 ),
			    CALCULATE (
			        DISTINCTCOUNT ( 'Fait_Historique des ventes'[Date] ),
			        'Dim_Calendrier'[Jour Semaine No] <= 5
			    )
			)
		displayFolder: 05 - Analyse temporelle
		lineageTag: 080f74e4-89c7-4829-851f-91da47ce0bc0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Nombre de jours ouvres calendaires (lundi a vendredi) sans promotion active. Meme base que [CA Moyen par Jour Ouvre] : jour calendaire reseau.
	measure 'Jours Ouvrés hors Promo' =
			-- =============================================
			-- MESURE : Jours Ouvres hors Promo
			-- Dossier : 05 - Analyse temporelle
			-- =============================================
			-- Description :
			--   Compte les dates distinctes du lundi au vendredi sans promotion.
			--   Verifie : la promotion est activee de facon uniforme sur tout le
			--   reseau un jour donne (aucune date mixte sur les 942 dates).
			--   Le comptage par date est donc licite.
			-- =============================================
			CALCULATE (
			    DISTINCTCOUNT ( 'Fait_Historique des ventes'[Date] ),
			    'Dim_Calendrier'[Jour Semaine No] <= 5,
			    'Fait_Historique des ventes'[Promotion active] = 0
			)
		formatString: #,0
		displayFolder: 05 - Analyse temporelle
		lineageTag: 8b0f4403-1a93-491b-8380-d83a77f7ab22

	/// CA reseau moyen d'un jour ouvre (lundi a vendredi) sans promotion. Reference non biaisee pour comparer le samedi, qui n'est jamais en promotion.
	measure 'CA Moyen par Jour Ouvré hors Promo' =
			-- =============================================
			-- MESURE : CA Moyen par Jour Ouvre hors Promo
			-- Dossier : 05 - Analyse temporelle
			-- =============================================
			-- Description :
			--   Pendant de [CA Moyen par Jour Ouvre], restreint aux jours
			--   sans promotion.
			-- Pourquoi :
			--   La promotion n'est jamais activee le samedi, alors qu'elle
			--   couvre 360 des 942 dates de la periode, toutes en semaine.
			--   Comparer un samedi a une moyenne lundi-vendredi incluant les
			--   jours promo revient a comparer deux regimes commerciaux.
			-- =============================================
			DIVIDE (
			    CALCULATE (
			        [CA Total],
			        'Dim_Calendrier'[Jour Semaine No] <= 5,
			        'Fait_Historique des ventes'[Promotion active] = 0
			    ),
			    [Jours Ouvrés hors Promo]
			)
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		displayFolder: 05 - Analyse temporelle
		lineageTag: fa41a74b-f25f-4198-8879-dc46bd39c56c

	/// Performance d'un samedi rapportee a celle d'un jour ouvre SANS promotion. Meme construction que [Indice Samedi], mais avec une reference debarrassee de l'effet promotion.
	measure 'Indice Samedi hors Promo' =
			-- =============================================
			-- MESURE : Indice Samedi hors Promo
			-- Dossier : 05 - Analyse temporelle
			-- =============================================
			-- Description :
			--   [CA Moyen par Samedi] rapporte a [CA Moyen par Jour Ouvre hors Promo].
			--   Le numerateur n'a pas besoin d'etre corrige : aucun samedi de la
			--   periode n'est en promotion.
			-- Lecture :
			--   100 % = samedi conforme a un jour ouvre hors promo
			-- =============================================
			DIVIDE ( [CA Moyen par Samedi], [CA Moyen par Jour Ouvré hors Promo] )
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: 05 - Analyse temporelle
		lineageTag: f7556a4b-b6dc-490c-97fa-b572353551d2

	measure 'Clients par Jour Ouvert' = DIVIDE ( [Passage en Caisse], [Jours Ouverts] )
		formatString: 0
		lineageTag: fc13c10e-92c2-4dc1-abdf-0c117f833511

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Titre Dynamique Graphiques 2' = ```
			
			VAR Annee = SELECTEDVALUE('Dim_Calendrier'[Annee], "Toutes les années")
			VAR Trimestre = SELECTEDVALUE('Dim_Calendrier'[Trimestre], "Tous les trimestres")
			VAR TypeMag = SELECTEDVALUE('Dim_Magasin'[Type de magasin], "Tous types")
			
			RETURN
			"Un écart stable sur les douze mois " & 
			IF(ISFILTERED('Dim_Calendrier'[Mois Abrege]), "Mois", " | " & "Période") & 
			" | " & Annee & " " & 
			" | Magasins : " & TypeMag
			```
		displayFolder: Icone
		lineageTag: fa6975fc-e4d9-43f4-8329-6a74168c8273

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clients par Jour Promo' =
			
			DIVIDE (
			    CALCULATE ( [Passage en Caisse],
			        'Fait_Historique des ventes'[Promotion active] = 1,
			        Dim_Calendrier[Jour Semaine No] <= 5 ),
			    CALCULATE ( [Jours Ouverts],
			        'Fait_Historique des ventes'[Promotion active] = 1,
			        Dim_Calendrier[Jour Semaine No] <= 5 )
			)
		displayFolder: 03 - Promotions
		lineageTag: 16dfc59a-21fb-487d-aca7-8fe40d43ddae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clients par Jour Hors Promo' =
			
			DIVIDE (
			    CALCULATE ( [Passage en Caisse],
			        'Fait_Historique des ventes'[Promotion active] = 0,
			        Dim_Calendrier[Jour Semaine No] <= 5 ),
			    CALCULATE ( [Jours Ouverts],
			        'Fait_Historique des ventes'[Promotion active] = 0,
			        Dim_Calendrier[Jour Semaine No] <= 5 )
			)
		displayFolder: 03 - Promotions
		lineageTag: 1f2b1d09-3015-4787-86dc-db28e39a5a07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Panier Moyen Promo' =
			
			DIVIDE (
			    CALCULATE ( [CA Total],
			        'Fait_Historique des ventes'[Promotion active] = 1,
			        Dim_Calendrier[Jour Semaine No] <= 5 ),
			    CALCULATE ( [Passage en Caisse],
			        'Fait_Historique des ventes'[Promotion active] = 1,
			        Dim_Calendrier[Jour Semaine No] <= 5 )
			)
		displayFolder: 03 - Promotions
		lineageTag: 26050520-0b1e-4951-b35f-72d5a4a72f99

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Panier Moyen Hors Promo' =
			
			DIVIDE (
			    CALCULATE ( [CA Total],
			        'Fait_Historique des ventes'[Promotion active] = 0,
			        Dim_Calendrier[Jour Semaine No] <= 5 ),
			    CALCULATE ( [Passage en Caisse],
			        'Fait_Historique des ventes'[Promotion active] = 0,
			        Dim_Calendrier[Jour Semaine No] <= 5 )
			)
		displayFolder: 03 - Promotions
		lineageTag: 81157d5a-b36b-4b8e-86ee-6390cd39f8cf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Uplift Clients %' =
			
			DIVIDE (
			    [Clients par Jour Promo] - [Clients par Jour Hors Promo],
			    [Clients par Jour Hors Promo]
			)
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: 03 - Promotions
		lineageTag: 4a72c5e1-672c-455c-b477-d74e4c2bfa7e

	measure 'Uplift Panier %' =
			
			DIVIDE (
			    [Panier Moyen Promo] - [Panier Moyen Hors Promo],
			    [Panier Moyen Hors Promo]
			)
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: 03 - Promotions
		lineageTag: e069c10d-81d4-4dc0-9fda-3dd91866f380

	measure 'Couleur cellule' =
			
			VAR _item = SELECTEDVALUE ( Temps[Colonne du groupe de calcul] )
			VAR _v = [CA Total]
			RETURN
			    IF (
			        _item = "Variation annuelle %",
			        IF ( _v >= 0, "#1B7F4B", "#C0392B" ),
			        "#333333"
			    )
		displayFolder: 07 - Couleurs dynamiques
		lineageTag: 070854e5-f102-4b22-a01a-919ab7c7dd20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column x
		isHidden
		lineageTag: a60cc81c-27f7-4f17-9b71-3cff4131a9f5
		isDefaultLabel
		isNameInferred
		sourceColumn: [x]

	partition _Mesures = calculated
		mode: import
		source = ROW("x", BLANK())

