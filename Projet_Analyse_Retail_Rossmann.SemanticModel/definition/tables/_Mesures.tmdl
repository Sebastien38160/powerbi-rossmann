table _Mesures
	lineageTag: b8926a1b-7fd1-4649-8258-b04a36b4e031

	/// Chiffre d'affaires total
	measure 'CA Total' =
			-- =============================================
			-- MESURE : CA Total
			-- Dossier : 01 - KPI de base
			-- =============================================
			-- Description :
			--   Additionne toutes les lignes de ventes de la table de faits.
			--   C'est la mesure fondamentale du modèle, utilisée comme base
			--   de calcul pour la quasi-totalité des autres mesures.
			-- Colonnes utilisées :
			--   Fait_Historique des ventes[Chiffre d'affaires]
			-- Précaution :
			--   Inclut les jours fermés (Magasin ouvert = 0) où le CA = 0.
			--   Pour un CA uniquement sur jours ouverts, utiliser avec
			--   un filtre sur [Magasin ouvert] = 1.
			-- =============================================
			SUM('Fait_Historique des ventes'[Chiffre d'affaires])
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		displayFolder: 01 - KPI de base
		lineageTag: baf2abe0-ba2f-47f9-8ed9-ef3d7349ded0

	/// Nombre de lignes de ventes
	measure 'Nombre de ventes' =
			-- =============================================
			-- MESURE : Nombre de ventes
			-- Dossier : 01 - KPI de base
			-- =============================================
			-- Description :
			--   Compte le nombre total de lignes dans la table de faits.
			--   Correspond au nombre de combinaisons Magasin x Jour.
			--   Attention : ce n'est PAS le nombre de transactions clients,
			--   mais le nombre d'enregistrements journaliers par magasin.
			-- =============================================
			COUNTROWS('Fait_Historique des ventes')
		formatString: #,0
		displayFolder: 01 - KPI de base
		lineageTag: 05f9b1cd-231d-4a5c-89c3-2aae982a60c5

	/// Nombre total de clients
	measure 'Passage en Caisse' =
			-- =============================================
			-- MESURE : Clients Total
			-- Dossier : 01 - KPI de base
			-- =============================================
			-- Description :
			--   Additionne le nombre de clients sur toutes les lignes.
			--   Représente le trafic client total sur la période.
			-- Colonnes utilisées :
			--   Fait_Historique des ventes[Nombre de clients]
			-- =============================================
			SUM('Fait_Historique des ventes'[Nombre de clients])
		formatString: #,0
		displayFolder: 01 - KPI de base
		lineageTag: aeb4d274-6539-44dd-a00c-80e7049bcfc9

	/// CA moyen par jour d'ouverture
	measure 'CA Moyen par Jour' =
			-- =============================================
			-- MESURE : CA Moyen par Jour
			-- Dossier : 01 - KPI de base
			-- =============================================
			-- Description :
			--   CA total divisé par le nombre de jours ouverts.
			--   Indique la performance journalière moyenne d'un magasin.
			--   Permet de comparer des périodes de longueurs différentes.
			-- Formule :
			--   Numérateur  : CA Total
			--   Dénominateur : nombre de lignes avec Magasin ouvert = 1
			-- =============================================
			DIVIDE(
			    [CA Total],
			    COUNTROWS(FILTER('Fait_Historique des ventes', 'Fait_Historique des ventes'[Magasin ouvert] = 1))
			)
		formatString: "€"\ #,0.0;-"€"\ #,0.0;"€"\ #,0.0
		displayFolder: 01 - KPI de base
		lineageTag: 38c26332-a6ad-416b-baf1-7edbd8cb9972

	/// Nombre moyen de clients par jour d'ouverture
	measure 'Clients Moyens par Jour' =
			-- =============================================
			-- MESURE : Clients Moyens par Jour
			-- Dossier : 01 - KPI de base
			-- =============================================
			-- Description :
			--   Nombre moyen de clients par jour d'ouverture.
			--   Mesure le trafic client journalier moyen.
			--   Complémentaire au CA Moyen par Jour pour distinguer
			--   un CA élevé dû au volume (trafic) vs. au panier.
			-- =============================================
			DIVIDE(
			    [Passage en Caisse],
			    COUNTROWS(FILTER('Fait_Historique des ventes', 'Fait_Historique des ventes'[Magasin ouvert] = 1))
			)
		formatString: #,0
		displayFolder: 01 - KPI de base
		lineageTag: 60807ea3-9397-4c5b-b3b9-e29e06c064b5

	/// Panier moyen
	measure 'CA par Client' =
			-- =============================================
			-- MESURE : CA par Client
			-- Dossier : 01 - KPI de base
			-- =============================================
			-- Description :
			--   CA total divisé par le nombre total de clients.
			--   Représente le panier moyen par visite.
			--   Indicateur clé pour évaluer la valeur par transaction.
			-- Interprétation :
			--   Une hausse peut signifier une montée en gamme
			--   ou une baisse du trafic (moins de clients mais plus dépensiers).
			-- =============================================
			DIVIDE([CA Total], [Passage en Caisse])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 01 - KPI de base
		lineageTag: ba3d35aa-fdce-448c-8968-9b5acc2c9c9b

	/// Nombre de jours d'ouverture
	measure 'Jours Ouverts' =
			-- =============================================
			-- MESURE : Jours Ouverts
			-- Dossier : 01 - KPI de base
			-- =============================================
			-- Description :
			--   Compte le nombre de lignes où le magasin était ouvert.
			--   Sert de dénominateur pour tous les calculs de moyennes
			--   journalières (CA Moyen par Jour, Clients Moyens par Jour).
			-- Colonnes utilisées :
			--   Fait_Historique des ventes[Magasin ouvert] = 1
			-- =============================================
			CALCULATE(
			    COUNTROWS('Fait_Historique des ventes'),
			    'Fait_Historique des ventes'[Magasin ouvert] = 1
			)
		formatString: #,0
		displayFolder: 01 - KPI de base
		lineageTag: ea5627ac-439a-4746-9e46-ecfdf6773678

	/// CA de la même période l'année précédente
	measure 'CA Année Précédente' = CALCULATE([CA Total], SAMEPERIODLASTYEAR('Dim_Calendrier'[Date]))
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		displayFolder: 02 - Performance temporelle
		lineageTag: 25d39b81-87d9-416c-a317-429f8874d273

	/// Évolution du CA vs année précédente
	measure 'Croissance CA YoY %' = DIVIDE([CA Total] - [CA Année Précédente], [CA Année Précédente])
		displayFolder: 02 - Performance temporelle
		lineageTag: 054bff51-8229-4eec-a302-5ee693613fd8

		formatStringDefinition = "▲+0.00 %;▼-0.00 %;0.00 %"

	/// CA cumulé depuis le début de l'année
	measure 'CA Cumul Année (YTD)' = TOTALYTD([CA Total], 'Dim_Calendrier'[Date])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 - Performance temporelle
		lineageTag: 1e3e8fcc-b564-4d85-84bc-3021a6791143

	/// CA cumulé depuis le début du trimestre
	measure 'CA Cumul Trimestre (QTD)' = TOTALQTD([CA Total], 'Dim_Calendrier'[Date])
		formatString: #,0 €
		displayFolder: 02 - Performance temporelle
		lineageTag: 90b7967f-af8a-42e9-8cb7-3fb61abdda8f

	/// CA cumulé depuis le début du mois
	measure 'CA Cumul Mois (MTD)' = TOTALMTD([CA Total], 'Dim_Calendrier'[Date])
		formatString: #,0 €
		displayFolder: 02 - Performance temporelle
		lineageTag: d53a04d3-e2a0-4c7c-9974-9a5851bb6fcb

	/// CA du mois précédent
	measure 'CA Mois Précédent' = CALCULATE([CA Total], PREVIOUSMONTH('Dim_Calendrier'[Date]))
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: 02 - Performance temporelle
		lineageTag: e7f8614a-0057-4c39-a692-773b0ca58196

	/// Évolution du CA vs mois précédent
	measure 'Croissance CA MoM %' = DIVIDE([CA Total] - [CA Mois Précédent], [CA Mois Précédent])
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: 02 - Performance temporelle
		lineageTag: dead4f6d-21e8-413b-9a72-b8cd73c21519

	/// Moyenne mobile du CA sur les 3 derniers mois
	measure 'CA Quotidien Moyen 14j' =
			
			VAR DateCourante = MAX ( Dim_Calendrier[Date] )
			RETURN
			CALCULATE (
			    AVERAGEX ( VALUES ( Dim_Calendrier[Date] ), [CA Total] ),
			    ALL ( Dim_Calendrier ),
			    Dim_Calendrier[Date] > DateCourante - 14,
			    Dim_Calendrier[Date] <= DateCourante
			)
		formatString: #,0 €
		displayFolder: 02 - Performance temporelle
		lineageTag: ba6eb263-92e1-4492-b813-feb66a5f388c

	/// CA réalisé lors des jours de promotion
	measure 'CA avec Promo' = CALCULATE([CA Total], 'Fait_Historique des ventes'[Promotion active] = 1)
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		displayFolder: 03 - Promotions
		lineageTag: 56713439-2793-47e1-a90f-b68c977cffec

	/// CA réalisé hors promotion
	measure 'CA sans Promo' = CALCULATE([CA Total], 'Fait_Historique des ventes'[Promotion active] = 0)
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		displayFolder: 03 - Promotions
		lineageTag: c016a771-ae6c-4709-988f-d48d1e0523bc

	/// Clients lors des jours de promotion
	measure 'Clients avec Promo' = CALCULATE([Passage en Caisse], 'Fait_Historique des ventes'[Promotion active] = 1)
		formatString: #,0
		displayFolder: 03 - Promotions
		lineageTag: 2f6480c8-1210-4d8a-8281-b55ffd1ed9c6

	/// Gain de CA moyen journalier avec promo vs sans promo
	measure 'Uplift CA Promo %' =
			
			VAR CA_Promo =
			    CALCULATE ( [CA Total],
			        'Fait_Historique des ventes'[Promotion active] = 1,
			        Dim_Calendrier[Jour Semaine No] <= 5 )
			VAR Jours_Promo =
			    CALCULATE ( [Jours Ouverts],
			        'Fait_Historique des ventes'[Promotion active] = 1,
			        Dim_Calendrier[Jour Semaine No] <= 5 )
			VAR CA_Sans =
			    CALCULATE ( [CA Total],
			        'Fait_Historique des ventes'[Promotion active] = 0,
			        Dim_Calendrier[Jour Semaine No] <= 5 )
			VAR Jours_Sans =
			    CALCULATE ( [Jours Ouverts],
			        'Fait_Historique des ventes'[Promotion active] = 0,
			        Dim_Calendrier[Jour Semaine No] <= 5 )
			VAR Moy_Promo = DIVIDE ( CA_Promo, Jours_Promo )
			VAR Moy_Sans = DIVIDE ( CA_Sans, Jours_Sans )
			RETURN
			    DIVIDE ( Moy_Promo - Moy_Sans, Moy_Sans )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 - Promotions
		lineageTag: 952518a9-6ffb-46ce-b6dc-9809f97363bf

	/// CA des magasins participant à la Promo2
	measure 'CA Promo récurrente' = CALCULATE([CA Total], 'Dim_Magasin'[Promo2 Active] = 1)
		formatString: #,0.0\ "€";-#,0.0\ "€";#,0.0\ "€"
		displayFolder: 03 - Promotions
		lineageTag: c1f9a4dc-3b62-480e-b22e-2304cc37a6c1

	/// Nombre de magasins distincts ayant vendu
	measure 'Nombre de Magasins Actifs' = DISTINCTCOUNT('Fait_Historique des ventes'[ID Magasin])
		formatString: #,0.0
		displayFolder: 04 - Magasins
		lineageTag: 72e705b4-5dc4-49ca-9896-457fb3af1a24

	/// CA moyen par magasin
	measure 'CA Moyen par Magasin' = DIVIDE([CA Total], DISTINCTCOUNT('Dim_Magasin'[ID Magasin]))
		displayFolder: 04 - Magasins
		lineageTag: a152ee66-2e5e-4deb-b63c-2928acef98f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Clients moyens par magasin
	measure 'Clients Moyens par Magasin' = DIVIDE([Passage en Caisse], [Nombre de Magasins Actifs])
		formatString: #,0
		displayFolder: 04 - Magasins
		lineageTag: ff4df461-9840-46b8-a81d-95fead2fb851

	/// Taux de jours d'ouverture sur la période
	measure 'Taux Ouverture %' = DIVIDE([Jours Ouverts], COUNTROWS('Fait_Historique des ventes'))
		formatString: 0.0%
		displayFolder: 04 - Magasins
		lineageTag: f600f8c4-4e17-46db-9edf-0fdc63ec079d

	/// CA réalisé le week-end
	measure 'CA Week-end' = CALCULATE([CA Total], 'Dim_Calendrier'[Est Weekend] = TRUE())
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: 05 - Analyse temporelle
		lineageTag: 8125e926-af34-4a1d-818d-ccc25b4f095f

	/// Part du CA réalisé le week-end
	measure 'Part CA Week-end %' = DIVIDE([CA Week-end], [CA Total])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: 05 - Analyse temporelle
		lineageTag: 67d9b3f5-ca65-459f-88b9-62d9d84dee3f

	/// Classement du magasin par CA décroissant
	measure 'Rang CA Magasin' = RANKX(ALL('Dim_Magasin'[ID Magasin]), [CA Total],, DESC, DENSE)
		formatString: #,0
		displayFolder: 06 - Mesures avancées
		lineageTag: 87c7ffd2-273d-4779-9cf6-a6729d8e9999

	measure 'Croissance CA' =
			
			VAR growth = [Croissance CA YoY %]
			VAR arrow =
			    IF(growth < 0, "▼ ", "▲ ")
			RETURN
			arrow & FORMAT(growth, "0.0%") & " vs N-1"
		displayFolder: 01 - KPI de base
		lineageTag: 373f3017-e0db-4923-9940-b10ee717d018

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Couleur Croissance' =
			
			IF(
			    [Croissance CA YoY %] < 0,
			    "#D64545",   -- rouge
			    "#2E8B57"    -- vert
			)
		displayFolder: 01 - KPI de base
		lineageTag: 4b2f10f7-902c-4bb8-8066-db8ba9f08120

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clients N-1' =
			
			CALCULATE(
			    [Passage en Caisse],
			    SAMEPERIODLASTYEAR(Dim_Calendrier[Date]))
		displayFolder: 01 - KPI de base
		lineageTag: 9eeea1d0-1d7b-4313-810c-27bf84a014f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Croissance Clients %' =
			
			DIVIDE(
			    [Passage en Caisse]-[Clients N-1],
			    [Clients N-1])
		displayFolder: 01 - KPI de base
		lineageTag: 65786e61-0a3e-4d4a-b379-209b1c3fb90c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Croissance_Clients =
			
			VAR growth = [Croissance Clients %]
			VAR arrow =
			    IF(growth < 0, "🔴 ", "🟢 ")
			RETURN
			arrow & FORMAT(growth, "0.0%") & " vs N-1"
		displayFolder: 01 - KPI de base
		lineageTag: 4c4becb7-dc30-4a2f-bd33-4226e12f496f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Couleur Clients' =
			
			IF(
			    [Croissance Clients %] < 0,
			    "#D64545",
			    "#2E8B57"
			)
		displayFolder: 01 - KPI de base
		lineageTag: b906fc05-d51b-4310-9fed-571a66e27029

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Croissance Clients' =
			
			VAR g = [Croissance Clients %]
			VAR arrow = IF(g < 0, "▼ ", "▲ ")
			RETURN
			arrow & FORMAT(g, "+0.0%;-0.0%") & " vs N-1"
		displayFolder: 01 - KPI de base
		lineageTag: 3495291c-7455-4d8c-b10e-7d7b1cd404a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Insight = ```
			VAR Mois = SELECTEDVALUE('Dim_Calendrier'[Mois])
			VAR Croissance = [Croissance CA YoY %]
			VAR CroissanceJour = [Croissance CA Constant %] 
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    -- Cas spécifique : CA total en baisse MAIS performance journalière en hausse
			    -- => la baisse vient du nombre de jours ouverts, pas de la performance commerciale
			    Croissance < 0 && CroissanceJour > 0,
			    "📉 CA en baisse mais " & FORMAT(CroissanceJour, "+0.0%") & " par jour ouvert" & UNICHAR(10) & "Moins de jours ouverts, pas une perte commerciale",
			
			    -- Cas : CA total ET performance journalière tous les deux en baisse
			    -- => véritable dégradient commercial
			    Croissance < 0 && CroissanceJour <= 0,
			    "⚠️ Baisse commerciale réelle" & UNICHAR(10) & "CA et performance journalière en recul",
			
			    -- Saisonnalité : juillet et août traditionnellement faibles
			    Mois IN {"juillet", "août"},
			    "⚠️ Baisse saisonnière du CA" & UNICHAR(10),
			
			    -- Saisonnalité : novembre et décembre traditionnellement forts
			    Mois IN {"novembre", "décembre"},
			    "📈 Forte activité commerciale" & UNICHAR(10),
			
			    -- Croissance positive standard
			    Croissance > 0,
			    "📈 Croissance positive du CA" & UNICHAR(10),
			
			    -- Défaut
			    "📉 Performance en baisse" & UNICHAR(10)
			)
			```
		displayFolder: 07 - Couleurs dynamiques
		lineageTag: 658d32c6-f166-49a6-b1ac-3942834bda53

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Insight Magasin' = ```
			
			VAR TypeMagasin = SELECTEDVALUE(Dim_Magasin[Type de magasin], "Global")
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    TypeMagasin = "B",
			    "🏬 Type B : meilleure performance (CA élevé)" 
			    & UNICHAR(10) & UNICHAR(10) &
			    "👉 Reco : prioriser ce format et reproduire ses leviers",
			
			    TypeMagasin = "A",
			    "🏪 Type A : performance intermédiaire" 
			    & UNICHAR(10) & UNICHAR(10) &
			    "👉 Reco : optimiser assortiment et trafic",
			
			    TypeMagasin = "C",
			    "🏪 Type C : performance similaire à A" 
			    & UNICHAR(10) & UNICHAR(10) &
			    "👉 Reco : activer promotions ciblées",
			
			    TypeMagasin = "D",
			    "🏬 Type D : performance la plus faible" 
			    & UNICHAR(10) & UNICHAR(10) &
			    "👉 Reco : rationaliser les coûts ou revoir le positionnement",
			
			    "📊 Vue globale : le type B surperforme nettement les autres formats"
			)
			```
		displayFolder: 01 - KPI de base
		lineageTag: d3e77746-e139-4be1-b72f-e7e0162e03d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Titre_graphique_cascade = "Contribution de chaque mois à la variation du CA (M€) pour l'année " & SELECTEDVALUE(Dim_Calendrier[Annee])
		displayFolder: 01 - KPI de base
		lineageTag: 6cfc0a48-2b90-43ff-b422-b1dd3c7ede0b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Titre Week-end' =
			
			VAR Selection =
			    IF (
			        ISFILTERED ( Dim_Magasin[Type de magasin] ),
			        "magasins de type " & CONCATENATEX ( VALUES ( Dim_Magasin[Type de magasin] ), Dim_Magasin[Type de magasin], ", " ),
			        "tous types de magasins"
			    )
			RETURN
			    "Analyse du week-end en " & SELECTEDVALUE ( Dim_Calendrier[Annee] ) & " — " & Selection
		displayFolder: 01 - KPI de base
		lineageTag: 184e84f7-9003-43ff-99ab-37f8aa98024c

