	measure 'Icone Promo Recurrente' =
			
			imgBadgeEmbeddedAllIcons("refresh-cw", "#FFFFFF", "#8E44AD", 60, 12, 2)
		displayFolder: Icone
		lineageTag: a212d1ad-8e08-404b-9b3d-0b0841485c3b

